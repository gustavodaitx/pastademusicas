# Firebase Spark (Plano Gratuito)
# Obtenha estas variáveis no Console do Firebase (Configurações do Projeto > Seus aplicativos > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Drive Picker API (Opcional - Fase T12)
# Requer projeto gratuito no Google Cloud Console com Drive API e Google Picker habilitados
VITE_GOOGLE_CLIENT_ID=000000000000-exemplo.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=AIzaSyExemploChaveGooglePickerPublica
VITE_GOOGLE_APP_ID=000000000000

# Patrocínio Pix Estático (Fase T13)
# Chave Pix voluntária e dados do recebedor (configuráveis pelo ADMIN)
VITE_PIX_CHAVE=chave-pix-exemplo@email.com
VITE_PIX_NOME_BENEFICIARIO=Responsavel PDS Pasta de Musica
VITE_PIX_CIDADE=Porto Alegre
